# Copy to .env.local for local development. Never commit real values.
# Local testing uses a file DB, no token needed:
TURSO_DATABASE_URL=<redacted>
TURSO_AUTH_TOKEN=<redacted>
# Admin password gate — store ONLY the scrypt hash, never a plaintext password.
# Generate one with: ADMIN_PASSWORD='your-password' node scripts/make-hash.mjs
APP_PASSWORD_HASH=
